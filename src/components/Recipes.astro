---
import type { ImageMetadata } from "astro";
import MdImage from "./MdImage.astro";

let urls = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/college-recipes/*.avif",
);

let pics = await Promise.all(
  Object.entries(urls).map(async ([k, v]) => {
    let alt = k
      .split("/")
      .pop()!
      .replace(/\.[^/.]+$/, "");
    return {
      alt,
      src: await v(),
    };
  }),
);

let containerID = `recipes-${crypto.randomUUID()}`;
const getViewerID = (index: number) => `${containerID}-viewer-${index}`;
---

<div id={containerID} class="recipe-container">
  {
    pics.map(({ src, alt }, i) => (
      <div
        class="img-container"
        tabindex="0"
        role="button"
        aria-label={`Open ${alt}`}
        data-viewer={getViewerID(i)}
      >
        <MdImage src={src.default} alt={alt} data-viewer={getViewerID(i)} />
      </div>
    ))
  }
  {
    pics.map(({ src, alt }, i) => (
      <dialog id={getViewerID(i)}>
        <MdImage src={src.default} alt={alt} />
      </dialog>
    ))
  }
</div>

<script define:vars={{ containerID }}>
  const container = document.getElementById(containerID);
  if (!container) return;

  container.addEventListener("click", (e) => {
    const target = e.target;
    if (target.dataset.viewer) {
      document.getElementById(target.dataset.viewer)?.showModal();
    } else if (target instanceof HTMLDialogElement && target === event.target) {
      target.close();
    }
  });

  container.addEventListener("keydown", (e) => {
    const target = e.target;
    if ((e.key === "Enter" || e.key === " ") && target.dataset.viewer) {
      e.preventDefault();
      document.getElementById(target.dataset.viewer)?.showModal();
    }
  });
</script>

<style>
  .recipe-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
  }
  .img-container {
    width: 180px;
    border-radius: 4px;
    overflow: hidden;
    height: fit-content;
    border: 1px solid light-dark(var(--color-gray-200), var(--color-gray-600));
    &:hover {
      border: 1px solid var(--color-purple-500);
      cursor: pointer;
    }
  }
</style>
